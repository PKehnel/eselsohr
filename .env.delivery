# Inert production-shaped config for intercepted local delivery checks only.
# No such Firebase project or usable credential is required.
VITE_USE_EMULATORS=false
VITE_FIREBASE_API_KEY=synthetic-delivery-key
VITE_FIREBASE_AUTH_DOMAIN=eselsohr-example.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=eselsohr-example
VITE_FIREBASE_APP_ID=1:123456789:web:synthetic-delivery
