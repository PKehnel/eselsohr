# Copy to .env.local for your own Firebase installation.
# These VITE_* values are public in the browser, never Admin credentials.
# For local development use npm run dev:emulator instead; no .env.local needed.
VITE_USE_EMULATORS=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
